# Bot Configuration
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=yourbotusername  # WITHOUT @ symbol, exactly as shown in @BotFather

# Owner Configuration (Multiple owners support)
# Single owner: OWNER_IDS=123456789
# Multiple owners: OWNER_IDS=123456789,987654321,555555555
OWNER_IDS=your_telegram_user_id

# Backward compatibility (optional, will be added to OWNER_IDS if set)
OWNER_ID=your_telegram_user_id

LOG_GROUP_ID=your_logger_group_id

# Database Configuration
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=sticker_kang_bot

# Telethon (Quotly ke liye)
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

