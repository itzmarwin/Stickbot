# ===== PACK MANAGEMENT - MESSAGES (handlers/pack_management.py) =====
NO_PACKS_MESSAGE= <b>𝖭𝗈 𝗉𝖺𝖼𝗄𝗌 𝗒𝖾𝗍.</b>\n𝖢𝗋𝖾𝖺𝗍𝖾 𝗒𝗈𝗎𝗋 𝖿𝗂𝗋𝗌𝗍 𝗍𝗈 𝗀𝖾𝗍 𝗌𝗍𝖺𝗋𝗍𝖾𝖽.
MANAGE_PACKS_MESSAGE=<b>𝖸𝗈𝗎𝗋 𝖲𝗍𝗂𝖼𝗄𝖾𝗋 𝖯𝖺𝖼𝗄𝗌</b>
SESSION_EXPIRED=❌ Session expired. Please try again.
PACK_OPTIONS_MESSAGE=🛠️ <b>𝖯𝖺𝖼𝗄 𝖮𝗉𝗍𝗂𝗈𝗇𝗌</b>\n\n<a href="{pack_link}">{pack_name}</a>\n<b>𝖲𝗍𝗂𝖼𝗄𝖾𝗋𝗌:</b> {sticker_count}/120
RENAME_PACK_INFO=✏️ 𝖢𝗁𝖺𝗇𝗀𝖾 𝗒𝗈𝗎𝗋 𝗉𝖺𝖼𝗄'𝗌 𝗇𝖺𝗆𝖾.
DELETE_PACK_INFO=🗑️ 𝖣𝖾𝗅𝖾𝗍𝖾 𝗍𝗁𝗂𝗌 𝗉𝖺𝖼𝗄 𝗉𝖾𝗋𝗆𝖺𝗇𝖾𝗇𝗍𝗅𝗒.
ADD_STICKER_INFO=🎨 𝖠𝖽𝖽 𝗎𝗉 𝗍𝗈 120 𝗌𝗍𝗂𝖼𝗄𝖾𝗋𝗌 (𝗂𝗆𝖺𝗀𝖾𝗌, 𝗏𝗂𝖽𝖾𝗈𝗌, 𝗀𝗂𝖿𝗌).
PUBLISH_PACK_INFO=📤 𝖯𝗎𝖻𝗅𝗂𝗌𝗁 𝗒𝗈𝗎𝗋 𝗉𝖺𝖼𝗄 𝗍𝗈 𝗆𝖺𝗄𝖾 𝗂𝗍 𝗌𝖾𝖺𝗋𝖼𝗁𝖺𝖻𝗅𝖾 𝗂𝗇 𝗂𝗇𝗅𝗂𝗇𝖾 𝗆𝗈𝖽𝖾.
RENAME_PACK_MESSAGE=✏️ <b>𝖱𝖾𝗇𝖺𝗆𝖾 𝖯𝖺𝖼𝗄</b>\n𝖲𝖾𝗇𝖽 𝖺 𝗇𝖾𝗐 𝗇𝖺𝗆𝖾 𝖿𝗈𝗋 <b>"{pack_name}"</b>.\n(𝖬𝖺𝗑 𝟨𝟦 𝖼𝗁𝖺𝗋𝖺𝖼𝗍𝖾𝗋𝗌, 𝖾𝗆𝗈𝗃𝗂𝗌 𝖺𝗅𝗅𝗈𝗐𝖾𝖽)
PACK_NAME_SEND_VALID=Please send a valid pack name.
PACK_NAME_TOO_LONG=Pack name is too long! Maximum 64 characters.
PACK_NAME_INVALID_SIMPLE=Invalid pack name!
PACK_RENAMED_SUCCESS=✅ <b>𝖯𝖺𝖼𝗄 𝗋𝖾𝗇𝖺𝗆𝖾𝖽!</b>\n\n<b>𝖮𝗅𝖽:</b> {old_name}\n<b>𝖭𝖾𝗐:</b> {new_name}
DELETE_PACK_CONFIRMATION=🗑️ <b>𝖣𝖾𝗅𝖾𝗍𝖾 𝖯𝖺𝖼𝗄</b>\n𝖠𝗋𝖾 𝗒𝗈𝗎 𝗌𝗎𝗋𝖾 𝗒𝗈𝗎 𝗐𝖺𝗇𝗍 𝗍𝗈 𝖽𝖾𝗅𝖾𝗍𝖾 <b>"{pack_name}"</b>?\n𝖳𝗁𝗂𝗌 𝖼𝖺𝗇'𝗍 𝖻𝖾 𝗎𝗇𝖽𝗈𝗇𝖾.\n\n<b>𝖯𝖺𝖼𝗄 𝖣𝖾𝗍𝖺𝗂𝗅𝗌:</b>\n- 𝖲𝗍𝗂𝖼𝗄𝖾𝗋𝗌: {sticker_count}\n- 𝖢𝗋𝖾𝖺𝗍𝖾𝖽: {created_date}
PACK_DELETED_SUCCESS=✅ <b>𝖯𝖺𝖼𝗄 𝖽𝖾𝗅𝖾𝗍𝖾𝖽!</b>\n\n<b>"{pack_name}"</b> 𝗁𝖺𝗌 𝖻𝖾𝖾𝗇 𝗋𝖾𝗆𝗈𝗏𝖾𝖽.
ADD_STICKER_INSTRUCTIONS=<b>Add Stickers to {pack_name}</b>\n\nSend me images, videos, GIFs, or stickers to add to your pack.\nI'll keep adding them until the pack is full.\n\n<b>Current count:</b> {sticker_count}/120\n<b>Supported formats:</b> Images, Videos (max 4MB), GIFs, Stickers
PACK_FULL_CANNOT_ADD=❌ Pack is full! Cannot add more stickers.
ADDING_STICKER_WAIT=⌛ Adding sticker to your pack...
STICKER_ADDED_SUCCESS=✅ <b>Sticker added successfully!</b>
PACK_FULL_120_LIMIT=❌ <b>Pack is full!</b>\n\nThis pack has reached the maximum limit of 120 stickers. Please create a new pack to add more stickers.
STICKER_ADD_FAILED=❌ Failed to add sticker. Please try again with a different file.
CREATE_NEW_PACK_PROMPT=<b>Let's create a new sticker pack!</b>\n\n<b>First, send me the sticker you want to start your pack with.</b>\nIt can be GIF, video, image or sticker
GOT_IT_SEND_PACK_NAME=👍 <b>Got it!</b> Now send me a name for your pack.\n\n<i>You can use any symbols, emojis, or fonts in the name.</i>
STICKER_DATA_LOST=❌ Sticker data lost. Please start over.
PACK_NAME_EMPTY=❌ Pack name cannot be empty.
CREATING_PACK_WAIT=⌛ <b>Creating your sticker pack...</b>\nPlease wait a moment
PACK_CREATED_SUCCESS=✅ <b>Your sticker pack has been created successfully!</b>\n\n<a href="{pack_link}">{pack_name}</a>
PACK_CREATE_FAILED_TEMP=❌ <b>Failed to create pack.</b>\nThis might be a temporary issue. Please try again.
OPERATION_CANCELLED=Operation cancelled.

PUBLISH_PACK_ASK_KEYWORD=📤 <b>Publish Pack</b>\n\n<b>Pack:</b> {pack_name}\n\nPlease send a keyword (3-20 characters, alphanumeric only) that people will use to find your pack via inline mode.\n\n<b>Example:</b> <code>@{bot_username} memes</code>
PUBLISH_KEYWORD_SEND_TEXT=❌ Please send a text keyword.
PUBLISH_KEYWORD_INVALID=❌ <b>Invalid keyword!</b>\n\nKeyword must be:\n- 3-20 characters long\n- Alphanumeric only (a-z, 0-9)\n- No spaces or special characters\n\nPlease try again.
PUBLISH_CONFIRM_REQUEST=📤 <b>Confirm Publish</b>\n\n<b>Pack:</b> {pack_name}\n<b>Keyword:</b> <code>{keyword}</code>\n\n<b>Usage:</b> <code>@{bot_username} {keyword}</code>\n\nAre you sure you want to submit this pack for publishing?
PUBLISH_REQUEST_SENT=✅ <b>Request sent!</b>\n\nYour pack <b>{pack_name}</b> has been submitted for publishing. You'll be notified when it's reviewed.
PUBLISH_REQUEST_APPROVED=✅ <b>Pack Published!</b>\n\n<b>Pack:</b> {pack_name}\n<b>Keyword:</b> <code>{keyword}</code>\n\n<b>Usage:</b> <code>@{bot_username} {keyword}</code>\n\nYour pack is now live! Anyone can find it by typing the keyword in inline mode.\n\n<a href="{pack_link}">View Pack</a>
PUBLISH_REQUEST_REJECTED=❌ <b>Publish Request Rejected</b>\n\nYour pack <b>{pack_name}</b> was not approved for publishing.
PUBLISH_ALREADY_PUBLISHED=⚠️ <b>This pack is already published!</b>\n\nYou cannot publish the same pack twice.
PUBLISH_NOT_CONFIGURED=❌ <b>Publish feature is not configured.</b>\n\nPlease contact the bot administrator.
PUBLISH_CANCELLED=❌ <b>Publish cancelled.</b>
