# ===== PACK MANAGEMENT - MESSAGES (handlers/pack_management.py) =====
NO_PACKS_MESSAGE= <b>𝖕𝖆𝖐𝖔𝖛 𝖕𝖔𝖐𝖆 𝖓𝖊𝖙.</b>\n𝖘𝖔𝖟𝖉𝖆𝖏𝖙𝖊 𝖕𝖊𝖗𝖛𝖞𝖏, 𝖈𝖙𝖔𝖇𝖞 𝖓𝖆𝖈𝖍𝖆𝖙𝖞.
MANAGE_PACKS_MESSAGE=<b>𝖛𝖆𝖘𝖍𝖎 𝖕𝖆𝖐𝖎 𝖘𝖙𝖎𝖐𝖊𝖗𝖔𝖛</b>
SESSION_EXPIRED=❌ Сессия истекла. Пожалуйста, попробуйте снова.
PACK_OPTIONS_MESSAGE=🛠️ <b>𝖓𝖆𝖘𝖙𝖗𝖔𝖏𝖐𝖎 𝖕𝖆𝖐𝖆</b>\n\n<a href="{pack_link}">{pack_name}</a>\n<b>𝖘𝖙𝖎𝖐𝖊𝖗𝖔𝖛:</b> {sticker_count}/120
RENAME_PACK_INFO=✏️ 𝖎𝖟𝖒𝖊𝖓𝖎𝖙𝖊 𝖓𝖆𝖟𝖛𝖆𝖓𝖎𝖊 𝖛𝖆𝖘𝖍𝖊𝖌𝖔 𝖕𝖆𝖐𝖆.
DELETE_PACK_INFO=🗑️ 𝖚𝖉𝖆𝖑𝖎𝖙𝖞 𝖊𝖙𝖔𝖙 𝖕𝖆𝖐 𝖓𝖆𝖛𝖘𝖊𝖌𝖉𝖆.
ADD_STICKER_INFO=🎨 𝖉𝖔𝖇𝖆𝖛𝖞𝖙𝖊 𝖉𝖔 120 𝖘𝖙𝖎𝖐𝖊𝖗𝖔𝖛 (𝖎𝖟𝖔𝖇𝖗𝖆𝖟𝖍𝖊𝖓𝖎𝖞𝖆, 𝖛𝖎𝖉𝖊𝖔, 𝖌𝖎𝖋).
PUBLISH_PACK_INFO=📤 𝖔𝖕𝖚𝖇𝖑𝖎𝖐𝖚𝖏𝖙𝖊 𝖛𝖆𝖘𝖍 𝖕𝖆𝖐, 𝖈𝖙𝖔𝖇𝖞 𝖊𝖌𝖔 𝖒𝖔𝖟𝖍𝖓𝖔 𝖇𝖞𝖑𝖔 𝖓𝖆𝖏𝖙𝖎 𝖛 𝖎𝖓𝖑𝖆𝖎𝖓-𝖗𝖊𝖟𝖍𝖎𝖒𝖊.
RENAME_PACK_MESSAGE=✏️ <b>𝖕𝖊𝖗𝖊𝖎𝖒𝖊𝖓𝖔𝖛𝖆𝖙𝖞 𝖕𝖆𝖐</b>\n𝖔𝖙𝖕𝖗𝖆𝖛𝖞𝖙𝖊 𝖓𝖔𝖛𝖔𝖊 𝖓𝖆𝖟𝖛𝖆𝖓𝖎𝖊 𝖉𝖑𝖞𝖆 <b>"{pack_name}"</b>.\n(𝖒𝖆𝖐𝖘. 64 𝖘𝖎𝖒𝖛𝖔𝖑𝖆, 𝖊𝖒𝖔𝖉𝖟𝖎 𝖗𝖆𝖟𝖗𝖊𝖘𝖍𝖊𝖓𝖞)
PACK_NAME_SEND_VALID=Пожалуйста, отправьте действительное название пака.
PACK_NAME_TOO_LONG=Название пака слишком длинное! Максимум 64 символа.
PACK_NAME_INVALID_SIMPLE=Недействительное название пака!
PACK_RENAMED_SUCCESS=✅ <b>𝖕𝖆𝖐 𝖕𝖊𝖗𝖊𝖎𝖒𝖊𝖓𝖔𝖛𝖆𝖓!</b>\n\n<b>𝖘𝖙𝖆𝖗𝖔𝖊:</b> {old_name}\n<b>𝖓𝖔𝖛𝖔𝖊:</b> {new_name}
DELETE_PACK_CONFIRMATION=🗑️ <b>𝖚𝖉𝖆𝖑𝖎𝖙𝖞 𝖕𝖆𝖐</b>\n𝖛𝖞 𝖚𝖛𝖊𝖗𝖊𝖓𝖞, 𝖈𝖙𝖔 𝖍𝖔𝖙𝖎𝖙𝖊 𝖚𝖉𝖆𝖑𝖎𝖙𝖞 <b>"{pack_name}"</b>?\n𝖊𝖙𝖔 𝖉𝖊𝖏𝖘𝖙𝖛𝖎𝖊 𝖓𝖊𝖑𝖞𝖟𝖞𝖆 𝖔𝖙𝖒𝖊𝖓𝖎𝖙𝖞.\n\n<b>𝖎𝖓𝖋𝖔𝖗𝖒𝖆𝖈𝖎𝖞𝖆 𝖔 𝖕𝖆𝖐𝖊:</b>\n- 𝖘𝖙𝖎𝖐𝖊𝖗𝖔𝖛: {sticker_count}\n- 𝖘𝖔𝖟𝖉𝖆𝖓: {created_date}
PACK_DELETED_SUCCESS=✅ <b>𝖕𝖆𝖐 𝖚𝖉𝖆𝖑ё𝖓!</b>\n\n<b>"{pack_name}"</b> 𝖇𝖞𝖑 𝖚𝖉𝖆𝖑ё𝖓.
ADD_STICKER_INSTRUCTIONS=<b>Добавить стикеры в {pack_name}</b>\n\nОтправьте мне изображения, видео, GIF или стикеры для добавления в ваш пак.\nЯ буду продолжать добавлять их, пока пак не заполнится.\n\n<b>Текущее количество:</b> {sticker_count}/120\n<b>Поддерживаемые форматы:</b> Изображения, Видео (макс. 4МБ), GIF, Стикеры
PACK_FULL_CANNOT_ADD=❌ Пак заполнен! Невозможно добавить больше стикеров.
ADDING_STICKER_WAIT=⌛ Добавление стикера в ваш пак...
STICKER_ADDED_SUCCESS=✅ <b>Стикер успешно добавлен!</b>
PACK_FULL_120_LIMIT=❌ <b>Пак заполнен!</b>\n\nЭтот пак достиг максимального лимита в 120 стикеров. Пожалуйста, создайте новый пак для добавления большего количества стикеров.
STICKER_ADD_FAILED=❌ Не удалось добавить стикер. Пожалуйста, попробуйте снова с другим файлом.
CREATE_NEW_PACK_PROMPT=<b>Давайте создадим новый набор стикеров!</b>\n\n<b>Сначала отправьте мне стикер, с которого вы хотите начать свой пак.</b>\nЭто может быть GIF, видео, изображение или стикер
GOT_IT_SEND_PACK_NAME=👍 <b>Понял!</b> Теперь отправьте мне название для вашего пака.\n\n<i>Вы можете использовать любые символы, эмодзи или шрифты в названии.</i>
STICKER_DATA_LOST=❌ Данные стикера потеряны. Пожалуйста, начните заново.
PACK_NAME_EMPTY=❌ Название пака не может быть пустым.
CREATING_PACK_WAIT=⌛ <b>Создание вашего набора стикеров...</b>\nПожалуйста, подождите немного
PACK_CREATED_SUCCESS=✅ <b>Ваш набор стикеров успешно создан!</b>\n\n<a href="{pack_link}">{pack_name}</a>
PACK_CREATE_FAILED_TEMP=❌ <b>Не удалось создать пак.</b>\nЭто может быть временная проблема. Пожалуйста, попробуйте снова.
OPERATION_CANCELLED=Операция отменена.

PUBLISH_PACK_ASK_KEYWORD=📤 <b>Опубликовать пак</b>\n\n<b>Пак:</b> {pack_name}\n\nПожалуйста, отправьте ключевое слово (3-20 символов, только буквы и цифры), которое люди будут использовать для поиска вашего пака через инлайн-режим.\n\n<b>Пример:</b> <code>@{bot_username} мемы</code>
PUBLISH_KEYWORD_SEND_TEXT=❌ Пожалуйста, отправьте текстовое ключевое слово.
PUBLISH_KEYWORD_INVALID=❌ <b>Недействительное ключевое слово!</b>\n\nКлючевое слово должно быть:\n- Длиной 3-20 символов\n- Только буквы и цифры (a-z, 0-9)\n- Без пробелов или специальных символов\n\nПожалуйста, попробуйте снова.
PUBLISH_CONFIRM_REQUEST=📤 <b>Подтвердить публикацию</b>\n\n<b>Пак:</b> {pack_name}\n<b>Ключевое слово:</b> <code>{keyword}</code>\n\n<b>Использование:</b> <code>@{bot_username} {keyword}</code>\n\nВы уверены, что хотите отправить этот пак для публикации?
PUBLISH_REQUEST_SENT=✅ <b>Запрос отправлен!</b>\n\nВаш пак <b>{pack_name}</b> был отправлен для публикации. Вы получите уведомление, когда он будет проверен.
PUBLISH_REQUEST_APPROVED=✅ <b>Пак опубликован!</b>\n\n<b>Пак:</b> {pack_name}\n<b>Ключевое слово:</b> <code>{keyword}</code>\n\n<b>Использование:</b> <code>@{bot_username} {keyword}</code>\n\nВаш пак теперь доступен! Любой может найти его, введя ключевое слово в инлайн-режиме.\n\n<a href="{pack_link}">Просмотреть пак</a>
PUBLISH_REQUEST_REJECTED=❌ <b>Запрос на публикацию отклонён</b>\n\nВаш пак <b>{pack_name}</b> не был одобрен для публикации.
PUBLISH_ALREADY_PUBLISHED=⚠️ <b>Этот пак уже опубликован!</b>\n\nВы не можете опубликовать один и тот же пак дважды.
